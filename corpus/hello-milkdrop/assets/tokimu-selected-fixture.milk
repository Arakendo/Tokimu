; Tokimu-authored MilkDrop 1-style parser fixture.
; It is not an external preset and does not claim preset compatibility.

[preset00]
fRating=3.0
fDecay=0.970
fGammaAdj=1.0
fZoom=1.0
per_frame_init_1=q1=0;
per_frame_1=q1=q1+1;
; First-party selected-shape bindings. These deliberately exercise the bounded
; provider rule rather than claiming general third-party `shapecode` support.
per_frame_2=shape_0_x=0.5+0.08*sin(time*0.7); shape_0_y=0.5+0.05*cos(time*1.1); shape_0_rad=0.14+mid*0.16; shape_0_ang=sin(time*0.8)*0.8;
per_pixel_1=zoom=1.0+0.02*sin(rad);
wavecode_0=sample=sample*0.5;
comp_shader_1=float4 main() { return 0; }
unknown_compatibility_key=42

[wave_0]
enabled=1
samples=128
bSpectrum=0
bUseDots=0
bDrawThick=1
bAdditive=1
scaling=1.1
r=0.25
g=0.85
b=1.0
a=0.80
x=0.5
y=0.5

[shape_0]
enabled=1
sides=6
additive=0
thickoutline=1
textured=0
x=0.5
y=0.5
rad=0.18
ang=0.0
r=1.0
g=0.75
b=0.20
a=0.65
