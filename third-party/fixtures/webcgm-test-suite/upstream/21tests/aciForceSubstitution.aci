<?xml version = "1.0" ?>
<!DOCTYPE webcgmConfig PUBLIC "-//OASIS//DTD WebCGM 2.1 Config//EN" "http://docs.oasis-open.org/webcgm/v2.1/webcgmConfig21.dtd">
<webcgmConfig>
  <fontMap>
    <mapList forceSubstitution="yes"
      cgmFont="Helvetica"
	substitutionList="Courier New"/>
  </fontMap>
</webcgmConfig>


